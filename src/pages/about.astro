---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import AboutContent from "@components/about/about-content.astro";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const content = {
  imageAlt: "Ekipa servisa MediaServis Nova Gorica",
  lead: "MediaServis Nova Gorica je servis mobilnih telefonov. Ukvarjamo se z diagnostiko, popravili in pomočjo pri težavah z napravami - od počenega zaslona do napake, ki je ne znaš opisati. Delujemo v okviru podjetja Sirsa d.o.o.",
  stats: [
    { icon: "heroicons:wrench-screwdriver", value: "Popravila", label: "vseh vrst naprav" },
    { icon: "heroicons:magnifying-glass", value: "Diagnostika", label: "najprej ugotovimo vzrok" },
    { icon: "heroicons:clock", value: "Hitri termini", label: "pogosto še isti dan" },
    { icon: "heroicons:shield-check", value: "Garancija", label: "na opravljeno popravilo" },
  ],
  storyHeading: "Kako poteka popravilo",
  timeline: [
    {
      year: "1. korak",
      title: "Pregled naprave",
      text: "Napravo pregledamo in ugotovimo, kaj je dejansko narobe. Brez ugibanja in brez nepotrebnih posegov.",
    },
    {
      year: "2. korak",
      title: "Jasna ponudba",
      text: "Pred popravilom ti povemo, kaj bomo naredili in koliko bo stalo. Ceno poznaš vnaprej.",
    },
    {
      year: "3. korak",
      title: "Popravilo",
      text: "Popravilo izvedemo s preverjenimi nadomestnimi deli in postopki, ki jih uporabljamo že vrsto let.",
    },
    {
      year: "4. korak",
      title: "Prevzem",
      text: "Napravo po popravilu preverimo in ti jo vrnemo pripravljeno za uporabo - po potrebi pomagamo tudi pri prenosu podatkov.",
    },
  ],
  highlightsHeading: "Zakaj MediaServis",
  highlights: [
    {
      icon: "heroicons:map-pin",
      title: "V Novi Gorici",
      text: "Najdeš nas na Ulici tolminskih puntarjev 4, 5000 Nova Gorica. Termin se dogovoriš vnaprej, zato ne čakaš v vrsti.",
    },
    {
      icon: "heroicons:chat-bubble-left-right",
      title: "Klepet v živo",
      text: "Vprašanje lahko postaviš kar prek klepeta na strani Kontakt - brez klicanja in brez čakanja na e-pošto.",
    },
    {
      icon: "heroicons:banknotes",
      title: "Cena vnaprej",
      text: "Ceno popravila poznaš, preden se lotimo dela. Brez skritih stroškov in brez presenečenj na računu.",
    },
    {
      icon: "heroicons:language",
      title: "Slovensko in italijansko",
      text: "Nova Gorica je dvojezično mesto, zato te sprejmemo v slovenščini ali italijanščini.",
    },
  ],
  openSourceHeading: "Kje nas najdeš",
  openSourceText: "MediaServis Nova Gorica, Ulica tolminskih puntarjev 4, 5000 Nova Gorica, Slovenija. Za vprašanja o popravilu uporabi klepet na strani Kontakt.",
};
---

<Layout title={t('pages.about.title')} description={t('pages.about.description')}>
  <Headline text={t('pages.about.title')} class="pb-10" />
  <AboutContent {...content} {locale} />
</Layout>
