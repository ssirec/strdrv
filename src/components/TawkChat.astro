---
interface Props {
  widgetId?: string;
  height?: string;
}

const { widgetId = '56c73659b74a0813627d275c', height = '520px' } = Astro.props;
const embedSrc = 'https://embed.tawk.to/56c73659b74a0813627d275c/1gsshkkuq';
---

<div id={`tawk_${widgetId}`} style={`min-height:${height};width:100%;`}></div>

<script is:inline define:vars={{ widgetId, embedSrc }}>
  var Tawk_API = Tawk_API || {}, Tawk_LoadStart = new Date();
  Tawk_API.embedded = 'tawk_' + widgetId;
  (function () {
    var s1 = document.createElement('script'),
      s0 = document.getElementsByTagName('script')[0];
    s1.async = true;
    s1.src = embedSrc;
    s1.charset = 'UTF-8';
    s1.setAttribute('crossorigin', '*');
    s0.parentNode.insertBefore(s1, s0);
  })();
</script>
